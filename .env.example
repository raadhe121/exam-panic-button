# AI (optional). Set one. Groq is used first if both are set.
# Without a key the plan uses the built-in planner; flashcards and quizzes need one.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Accounts, saved exams, notes, flashcards, quizzes (Supabase). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Push reminders. Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
